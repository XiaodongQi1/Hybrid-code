{
  "Schema": "versioned-evm-run/v1",
  "Backend": "hybrid-rocksdb",
  "Codec": "ethereum-mpt",
  "Synthetic": {
    "BackgroundAccounts": 1000,
    "Blocks": 20,
    "TransactionsPerBlock": 40,
    "Contracts": 16,
    "StorageSlots": 32,
    "Pattern": "migrate",
    "Seed": 1
  },
  "HybridCache": {
    "Mode": "prefix-boundary",
    "Boundary": {
      "MaxNodeBytes": 532,
      "NodeBudget": {
        "TotalBytes": 262144,
        "AccountReserveBytes": 65536,
        "StorageReserveBytes": 65536
      },
      "PolicyIntervalBlocks": 16,
      "PolicyOriginHeight": 0,
      "HalfLife": 64,
      "MaxResidentTries": 256,
      "WorkUnits": 262144,
      "CandidateBytes": 2097152,
      "MetadataBytes": 4194304,
      "PlanBytes": 2097152,
      "HeatBucketCount": 4,
      "HeatBucketBlocks": 64,
      "HeatSketchRows": 4,
      "HeatSketchWidth": 16384
    }
  },
  "MaxBatchBytes": 8388608,
  "HybridSnapshot": {
    "ChunkEntries": 256,
    "CheckpointAccounts": 256,
    "BatchBytes": 1048576,
    "ScratchPath": "",
    "KeepScratch": false
  },
  "HybridInitialization": "prefix"
}
